{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "marketplaceproject-two.vercel.app" }],
      "destination": "https://vrna.io/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/product/:handle",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|facebot|twitterbot|whatsapp|slack|discord|telegram|linkedin|pinterest|embedly|skype|applebot|preview).*"
        }
      ],
      "destination": "/api/product-meta?handle=:handle"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
